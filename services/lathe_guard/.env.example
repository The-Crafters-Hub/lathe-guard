# LatheGuard Physical AI — Environment Configuration
# Copy this file to .env and fill in your Nebius Token Factory credentials.
# If NEBIUS_API_KEY is omitted, LatheGuard runs in offline-first Tier-0 local coaching mode.

NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
# Nebius Token Factory API endpoint (https://api.studio.nebius.ai/v1 or https://api.tokenfactory.nebius.com/v1)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Optional: Nebius tenant organization ID (leave empty unless using enterprise/org routing)
NEBIUS_ORG_ID=

# Tier-1 Fast Contextual Coach (low-latency ~600ms streaming Osta feedback)
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Tier-2 Formal NEBOSH Compliance Incident Reporting Model (e.g. nvidia/Nemotron-3-Ultra-550b-a55b)
# Used for deep post-trip incident root-cause analysis and OSHA/AAW regulatory grounding.
# If omitted, LatheGuard dynamically detects available models or falls back to NEBIUS_MODEL.
NEBIUS_REPORT_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional: Tavily Search API (Tier-2 reports cite live published safety guidance). Omit to skip.
TAVILY_API_KEY=
TAVILY_TIMEOUT_S=6.0
